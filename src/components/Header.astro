---
export interface Props {
  title?: string;
}
const { title = 'Christ Sword' } = Astro.props;
---

<header class="header">
  <div class="container">
    <a href="/" class="logo">
      <img src="/images/hero-christ.jpg" alt="Christ Sword" class="logo-img" />
      <span class="logo-text">{title}</span>
    </a>
    <nav class="nav">
      <a href="/">Home</a>
      <a href="/watch">Watch</a>
      <a href="/submit">Submit</a>
      <a href="/about">About</a>
      <a href="/admin/login">Admin</a>
    </nav>
  </div>
</header>

<style>
  .header {
    background: #1a1a2e;
    border-bottom: 3px solid #c5a059;
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.5rem;
    color: #f0e6d2;
    font-family: Georgia, serif;
  }
  .logo-img {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border: 2px solid #c5a059;
  }
  .nav {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .nav a {
    color: #c5a059;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .nav a:hover {
    color: #f0e6d2;
  }
  @media (max-width: 640px) {
    .container { flex-direction: column; align-items: stretch; }
    .nav { justify-content: center; width: 100%; }
    .logo { justify-content: center; }
  }
</style>
