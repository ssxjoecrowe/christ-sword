---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Christ Sword — Watching, praying, and standing for Christ and Christianity worldwide." />
    <title>Christ Sword | Stand Firm in the Faith</title>
    <style>
      :root { --gold: #c5a059; --dark: #1a1a2e; --darker: #16213e; --light: #f0e6d2; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: Georgia, serif; background: var(--dark); color: var(--light); line-height: 1.6; min-height: 100vh; display: flex; flex-direction: column; }
      .container { max-width: 1000px; margin: 0 auto; padding: 0 1.5rem; }
      main { flex: 1; }
      .hero { background: var(--darker); border: 2px solid var(--gold); padding: 4rem 2rem; text-align: center; margin: 2rem 0; }
      .hero img { width: 100%; max-width: 400px; border: 4px solid var(--gold); box-shadow: 0 0 40px rgba(197,160,89,0.3); margin-bottom: 1.5rem; }
      .hero h1 { font-size: 2.5rem; color: var(--gold); margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 2px; }
      .hero p { font-size: 1.15rem; max-width: 600px; margin: 0 auto 2rem; opacity: 0.9; }
      .btn { display: inline-block; background: var(--gold); color: #16213e; padding: 0.8rem 1.5rem; text-decoration: none; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; border-radius: 4px; }
      .btn:hover { background: #d4a96b; }
      .section { padding: 3rem 0; }
      .section h2 { color: var(--gold); font-size: 1.75rem; margin-bottom: 1.5rem; border-left: 4px solid var(--gold); padding-left: 1rem; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; }
      .card { background: var(--darker); border: 1px solid #2a3a5c; padding: 1.5rem; border-radius: 8px; }
      .card h3 { color: var(--light); margin-bottom: 0.75rem; }
      .card p { font-size: 0.95rem; opacity: 0.85; }
      .verse { font-style: italic; color: #c5a059; text-align: center; margin: 2rem 0; font-size: 1.2rem; }
    </style>
  </head>
  <body>
    <Header title="Christ Sword" />
    <main>
      <section class="hero">
        <img src="/images/hero-christ.jpg" alt="Christ the Geometer" />
        <h1>Christ Sword</h1>
        <p>Watching, praying, and standing firm for Christ and Christianity in every nation.</p>
        <a href="/submit" class="btn">Submit a Report</a>
      </section>
      <div class="verse">"Be on your guard; stand firm in the faith; be courageous; be strong." — 1 Corinthians 16:13</div>
      <section class="section">
        <div class="container">
          <h2>Current Watch</h2>
          <div class="grid">
            <article class="card"><h3>Persecution Alerts</h3><p>Monitoring nations where believers face imprisonment, violence, or restriction for following Jesus.</p></article>
            <article class="card"><h3>Doctrinal Watch</h3><p>Testing teachings against Scripture. Contending for the faith once delivered to the saints.</p></article>
            <article class="card"><h3>Prayer Network</h3><p>Uniting Christians worldwide to pray for the persecuted church and for revival.</p></article>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
